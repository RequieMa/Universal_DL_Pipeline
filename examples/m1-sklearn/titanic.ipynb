   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# M1: Sklearn — Logistic Regression on Titanic\\n",
    "\\n",
    "Load the Titanic dataset, wrap a `LogisticRegression` in `SklearnModel`,\\n",
    "use stub `Loss`/`Optimizer`, and override `train()` to call `.fit()`.\\n",
    "\\n",
    "**Prerequisites:** `pip install scikit-learn pandas`"
   ]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "source": [
    "import numpy as np\\n",
    "import pandas as pd\\n",
    "from sklearn.linear_model import LogisticRegression\\n",
    "from sklearn.preprocessing import StandardScaler\\n",
    "\\n",
    "from pipeline.config import Config\\n",
    "from pipeline.data.csv_source import CsvDataSource\\n",
    "from pipeline.data.split import train_test_split\\n",
    "from pipeline.data.utils import collect_arrays\\n",
    "from pipeline.evaluation.metrics import Metrics, accuracy, f1_score, confusion_matrix\\n",
    "from pipeline.hooks.progress import ProgressHook\\n",
    "from pipeline.pipeline import BasePipeline, PipelineState\\n",
    "from pipeline.adapters.sklearn_adapter import SklearnModel, StubLoss, StubOptimizer\\n",
    "\\n",
    "print(\\"Imports OK\\")"
   ],
   "outputs": [],
   "execution_count": null
  },
  {
   "cell_type": "code",
   "metadata": {},
   "source": [
    "# Configuration\\n",
    "config = Config(\\n",
    "    data_dir=\\"./data/titanic\\",\\n",
    "    output_dir=\\"./outputs/m1-sklearn\\",\\n",
    "    batch_size=32,\\n",
    "    num_epochs=1,\\n",
    "    train_ratio=0.8,\\n",
    "    seed=42,\\n",
    "    task_name=\\"titanic-sklearn\\",\\n",
    ")"
   ],
   "outputs": [],
   "execution_count": null
  },
  {
   "cell_type": "code",
   "metadata": {},
   "source": [
    "class TitanicSklearnPipeline(BasePipeline):\\n",
    "    \\"\\"\\"Sklearn LogisticRegression on Titanic.\\"\\"\\"\\n",
    "\\n",
    "    def load_data(self, state):\\n",
    "        source = CsvDataSource(\\n",
    "            \\"data/titanic/train.csv\\",\\n",
    "            batch_size=config.batch_size,\\n",
    "            target_column=\\"Survived\\",\\n",
    "            shuffle=True,\\n",
    "            seed=config.seed,\\n",
    "        )\\n",
    "        train, val = train_test_split(source, train_ratio=config.train_ratio)\\n",
    "        state.data_stream = train\\n",
    "        state.val_data_stream = val\\n",
    "\\n",
    "    def build_model(self, state):\\n",
    "        from sklearn.pipeline import make_pipeline\\n",
    "        est = make_pipeline(\\n",
    "            StandardScaler(),\\n",
    "            LogisticRegression(max_iter=1000, random_state=config.seed),\\n",
    "        )\\n",
    "        state.model = SklearnModel(est)\\n",
    "        state.loss_fn = StubLoss()\\n",
    "        state.optimizer = StubOptimizer()\\n",
    "        state.metrics = Metrics(accuracy=accuracy, f1=f1_score)\\n",
    "\\n",
    "    def train(self, state):\\n",
    "        X, y = collect_arrays(state.data_stream)\\n",
    "        state.model._estimator.fit(X, y)\\n",
    "        state.history = {\\"loss\\": [0.0]}\\n",
    "\\n",
    "    def evaluate(self, state):\\n",
    "        state.model.eval_mode()\\n",
    "        preds, trues = [], []\\n",
    "        for batch in state.val_data_stream:\\n",
    "            probs = np.asarray(state.model.forward(batch.inputs))\\n",
    "            preds.append(np.argmax(probs, axis=1))\\n",
    "            trues.append(np.asarray(batch.targets))\\n",
    "        y_pred = np.concatenate(preds)\\n",
    "        y_true = np.concatenate(trues)\\n",
    "        state.metrics.compute(y_true, y_pred)\\n",
    "\\n",
    "    def export(self, state):\\n",
    "        # Load test set and predict\\n",
    "        test_source = CsvDataSource(\\n",
    "            \\"data/titanic/test.csv\\",\\n",
    "            batch_size=config.batch_size,\\n",
    "            target_column=\\"PassengerId\\",\\n",
    "            shuffle=False,\\n",
    "        )\\n",
    "        test_preds = []\\n",
    "        for batch in test_source:\\n",
    "            probs = np.asarray(state.model.forward(batch.inputs))\\n",
    "            test_preds.append(np.argmax(probs, axis=1))\\n",
    "        state.predictions = np.concatenate(test_preds)"
   ],
   "outputs": [],
   "execution_count": null
  },
  {
   "cell_type": "code",
   "metadata": {},
   "source": [
    "pipeline = TitanicSklearnPipeline(config)\\n",
    "pipeline.add_hook(ProgressHook())\\n",
    "state = pipeline.run(\\"train\\")\\n",
    "\\n",
    "print(f\\"\\\\nAccuracy:  {state.metrics['accuracy']:.4f}\\")\\n",
    "print(f\\"F1 Score:  {state.metrics['f1']:.4f}\\")\\n",
    "print(\\"Training complete!\\")"
   ],
   "outputs": [],
   "execution_count": null
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## What happened?\\n",
    "\\n",
    "1. `SklearnModel` wrapped a `LogisticRegression` inside a `StandardScaler` pipeline.\\n",
    "2. `StubLoss` and `StubOptimizer` satisfied the pipeline contract — they do nothing,\\n",
    "   because sklearn's `.fit()` handles training internally.\\n",
    "3. The pipeline overrode `train()` to call `_estimator.fit(X, y)` on the full dataset,\\n",
    "   instead of the per-batch gradient descent loop.\\n",
    "4. `evaluate()` used `predict_proba()` → `argmax` to compute accuracy and F1.\\n",
    "\\n",
    "**Key insight:** sklearn and gradient descent train differently. The pipeline\\n",
    "accommodates both — sklearn overrides `train()`, numpy uses the default `TrainLoop`."
   ]
  }
 ],
