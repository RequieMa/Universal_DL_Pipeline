# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/

# Virtual environment
.venv/

# uv
uv.lock

# Data files (test datasets, gitignored — sample train.csv is an exception)
data/*.csv
!data/train.csv
data/*.zip
data/*.gz
data/*.tar
data/*.json
data/*.pth
data/*.pt
data/*.onnx
data/*.pkl

# Keep directory structure and README files in data/
!data/**/README.md
!data/**/.gitkeep

# IDE
.vscode/
.idea/
*.swp
*.swo

# User config (not committed — each developer writes their own)
config.yaml

# Pipeline outputs (runtime artifacts)
outputs/

# Docs build output (generated by mkdocs build)
site/

# OS
.DS_Store
Thumbs.db
